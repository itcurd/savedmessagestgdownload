# === Telegram API credentials ===
# Получить на https://my.telegram.org -> "API development tools"
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Номер телефона твоего Telegram-аккаунта в международном формате
PHONE=+79991234567

# === Файл сессии Telethon ===
# Создастся автоматически при первом успешном входе.
# При повторных запусках вход по коду больше не потребуется.
SESSION_NAME=saved_messages_session

# === Результат работы ===
# Путь к итоговому xlsx-файлу
OUTPUT_XLSX=saved_links.xlsx

# === Параметры обработки ===
# Сколько последних сообщений просматривать за один запуск. 0 = без ограничения (все сообщения)
MESSAGE_LIMIT=0

# Таймаут ожидания ответа сайта, сек
HTTP_TIMEOUT=10

# Пауза между запросами к сайтам, сек (чтобы не долбить сайты подряд и не словить бан по IP)
REQUEST_DELAY=1

# Эмодзи-реакция, которой помечаются обработанные сообщения
REACTION_EMOJI=🗑

# === Домены-исключения ===
# Для этих доменов (и их поддоменов) скрипт НЕ будет ходить по ссылке и парсить title/description -
# домен просто попадёт в таблицу с пометкой "исключение". Полезно для github.com и файловых ссылок,
# которые либо не отдают внятный title, либо не стоит лишний раз дёргать.
# Через запятую, без пробелов и без http(s)://
EXCLUDED_DOMAINS=github.com,raw.githubusercontent.com,githubusercontent.com,gist.github.com,github.io,api.github.com,codeload.github.com,t.me,telegram.org,telegram.me,web.telegram.org
